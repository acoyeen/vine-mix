#include <windows.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VINEMIX_RESOURCE_VERSION@
 PRODUCTVERSION @VINEMIX_RESOURCE_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "VineMix\0"
            VALUE "FileDescription", "VineMix audio engine\0"
            VALUE "FileVersion", "@VINEMIX_NUMERIC_VERSION@\0"
            VALUE "InternalName", "VineMix.Engine\0"
            VALUE "OriginalFilename", "VineMix.Engine.exe\0"
            VALUE "ProductName", "VineMix\0"
            VALUE "ProductVersion", "@VINEMIX_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
